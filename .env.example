# llm-arena 環境設定範例。
# 用法：複製成 .env（已 gitignore，不進版控）後二擇一設定 OpenRouter API key。
#
# --- 方式 A：直接把 key 寫在這裡 -------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-...
# （別名 OPENROUTER_KEY 也接受）
#
# --- 方式 B：指向中央金鑰檔（一份 key 給多個程式共用；建議）------------------
# 中央金鑰檔本身也是 dotenv 格式（KEY=VALUE 一行一筆），可分組註解，
# 分組標題那種沒有 "=" 的行會被忽略。
ARENA_ENV_FILE=~/.keys/.env

# --- 其他可選設定 -----------------------------------------------------------
# ARENA_DOTENV=...                     # 覆寫「專案 .env」的路徑
# ARENA_EVIDENCE_FILES=a.jsonl:b.jsonl # score/build 只讀指定檔（預設 data/evidence/*.jsonl）
# ARENA_SCORE_NO_BATCH=1               # 強制同步呼叫評審（預設即同步）
